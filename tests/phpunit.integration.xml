<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="integration/bootstrap.php" cacheResult="false">
	<testsuite name="integration">
		<directory suffix="Test.php">integration</directory>
	</testsuite>
	<source>
		<include>
			<directory suffix=".php">../lib</directory>
		</include>
		<!-- ADR 13: the bootstrap class and schema migrations are left out of the coverage target. -->
		<exclude>
			<file>../lib/AppInfo/Application.php</file>
			<directory prefix="Version" suffix=".php">../lib/Migration</directory>
		</exclude>
	</source>
</phpunit>
