{
  "name": "appstore_cards",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build",
    "lint": "eslint src tests/playwright playwright.config.ts",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "watch": "vite --mode development build --watch",
    "ts:check": "vue-tsc --noEmit && tsc --noEmit -p tests/playwright",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start:nextcloud": "node tests/playwright/start-nextcloud-server.mjs",
    "playwright": "playwright test",
    "playwright:install-ci": "playwright install --with-deps --only-shell chromium"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/vue": "^9.14.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/e2e-test-server": "^0.6.1",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.4",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
